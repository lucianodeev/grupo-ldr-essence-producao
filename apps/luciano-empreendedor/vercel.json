{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "lucianoempreendendor.com" }],
      "status": 308,
      "headers": { "Location": "https://www.lucianoempreendendor.com/$1" }
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "lucianoempreendedor.com" }],
      "status": 308,
      "headers": { "Location": "https://www.lucianoempreendendor.com/$1" }
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.lucianoempreendedor.com" }],
      "status": 308,
      "headers": { "Location": "https://www.lucianoempreendendor.com/$1" }
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "lucianoempreendedor-plataforma.vercel.app" }],
      "status": 308,
      "headers": { "Location": "https://clinicasocial.ldrrhestrategia.com/$1" }
    },
    {
      "src": "/(?:index|clinica)\\.html",
      "status": 308,
      "headers": { "Location": "https://clinicasocial.ldrrhestrategia.com/" }
    },
    {
      "src": "/",
      "dest": "/index.html",
      "headers": {
        "Link": "<https://clinicasocial.ldrrhestrategia.com/>; rel=\"canonical\""
      }
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt",
      "headers": { "Content-Type": "text/plain; charset=utf-8" }
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml",
      "headers": { "Content-Type": "application/xml; charset=utf-8" }
    },
    { "handle": "filesystem" }
  ]
}
