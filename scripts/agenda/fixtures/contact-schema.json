  "submission": "CREATE OR REPLACE FUNCTION public.submit_ecosystem_contact(p_name text, p_email text, p_phone text, p_subject text, p_message text, p_source_project text, p_source_url text, p_language text, p_wants_luciano boolean, p_consent boolean, p_website text DEFAULT NULL::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare c public.ecosystem_contacts; raw_token text;\nbegin\n if coalesce(trim(p_website),'')<>'' then raise exception 'invalid submission'; end if;\n if not p_consent then raise exception 'consent required'; end if;\n if char_length(trim(p_name)) not between 2 and 120 or char_length(trim(p_email)) not between 5 and 254 or position('@' in p_email)<2 or char_length(trim(p_subject)) not between 2 and 100 or char_length(trim(p_message)) not between 5 and 4000 then raise exception 'invalid submission'; end if;\n if p_language not in ('pt','en','fr','es') then raise exception 'invalid language'; end if;\n raw_token:=encode(gen_random_bytes(32),'hex');\n insert into public.ecosystem_contacts(name,email,phone,subject,message,source_project,source_url,language,wants_luciano,consent_contact,upload_token_hash,upload_token_expires_at)\n values(trim(p_name),lower(trim(p_email)),nullif(trim(p_phone),''),trim(p_subject),trim(p_message),coalesce(nullif(trim(p_source_project),''),'LDR Ecosystem'),nullif(trim(p_source_url),''),p_language,coalesce(p_wants_luciano,false),true,encode(digest(raw_token,'sha256'),'hex'),now()+interval '2 hours') returning * into c;\n insert into public.ecosystem_contact_messages(contact_id,direction,channel,body,sender,recipient) values(c.id,'inbound','email',c.message,c.email,'LDR');\n return jsonb_build_object('protocol',c.protocol,'uploadToken',raw_token);\nend $function$\n",
  "constraints": [
    {
      "name": "ecosystem_contacts_email_check",
      "table": "ecosystem_contacts",
      "definition": "CHECK (((char_length(email) >= 5) AND (char_length(email) <= 254)))"
    },
    {
      "name": "ecosystem_contacts_language_check",
      "table": "ecosystem_contacts",
      "definition": "CHECK ((language = ANY (ARRAY['pt'::text, 'en'::text, 'fr'::text, 'es'::text])))"
    },
    {
      "name": "ecosystem_contacts_message_check",
      "table": "ecosystem_contacts",
      "definition": "CHECK (((char_length(message) >= 5) AND (char_length(message) <= 4000)))"
    },
    {
      "name": "ecosystem_contacts_name_check",
      "table": "ecosystem_contacts",
      "definition": "CHECK (((char_length(name) >= 2) AND (char_length(name) <= 120)))"
    },
    {
      "name": "ecosystem_contacts_pkey",
      "table": "ecosystem_contacts",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "ecosystem_contacts_priority_check",
      "table": "ecosystem_contacts",
      "definition": "CHECK ((priority = ANY (ARRAY['normal'::text, 'alta'::text])))"
    },
    {
      "name": "ecosystem_contacts_protocol_key",
      "table": "ecosystem_contacts",
      "definition": "UNIQUE (protocol)"
    },
    {
      "name": "ecosystem_contacts_status_check",
      "table": "ecosystem_contacts",
      "definition": "CHECK ((status = ANY (ARRAY['novo'::text, 'em_atendimento'::text, 'aguardando_cliente'::text, 'respondido'::text, 'resolvido'::text])))"
    },
    {
      "name": "ecosystem_contacts_subject_check",
      "table": "ecosystem_contacts",
      "definition": "CHECK (((char_length(subject) >= 2) AND (char_length(subject) <= 100)))"
    },
    {
      "name": "ecosystem_contact_messages_body_check",
      "table": "ecosystem_contact_messages",
      "definition": "CHECK (((char_length(body) >= 1) AND (char_length(body) <= 10000)))"
    },
    {
      "name": "ecosystem_contact_messages_channel_check",
      "table": "ecosystem_contact_messages",
      "definition": "CHECK ((channel = ANY (ARRAY['email'::text, 'admin'::text])))"
    },
    {
      "name": "ecosystem_contact_messages_contact_id_fkey",
      "table": "ecosystem_contact_messages",
      "definition": "FOREIGN KEY (contact_id) REFERENCES ecosystem_contacts(id) ON DELETE CASCADE"
    },
    {
      "name": "ecosystem_contact_messages_created_by_fkey",
      "table": "ecosystem_contact_messages",
      "definition": "FOREIGN KEY (created_by) REFERENCES auth.users(id)"
    },
    {
      "name": "ecosystem_contact_messages_direction_check",
      "table": "ecosystem_contact_messages",
      "definition": "CHECK ((direction = ANY (ARRAY['inbound'::text, 'outbound'::text])))"
    },
    {
      "name": "ecosystem_contact_messages_pkey",
      "table": "ecosystem_contact_messages",
      "definition": "PRIMARY KEY (id)"
    }
  ]
